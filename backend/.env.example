# IBM watsonx.ai Credentials (optional; mock responses used when absent)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
EMBEDDING_MODEL_ID=ibm/slate-125m-english-rtrvr

# ChromaDB & Corpus Paths
CHROMA_PERSIST_DIR=./data/chroma
CORPUS_DIR=./data/corpus

# Weather API
WEATHER_API_BASE=https://api.open-meteo.com
FORECAST_CACHE_TTL=3600

# Pipeline Thresholds (Configurable §7)
ANOMALY_THRESHOLD_PCT=20.0
BASELINE_YEARS=15
RETRIEVAL_TOP_K=8
RELEVANCE_FLOOR=0.35
MIN_PASSAGES_FOR_ADVISORY=3
PIPELINE_TIMEOUT_S=30

# File Storage Paths
AUDIO_DIR=./data/audio
DEMO_CACHE_DIR=./data/demo_cache
SEED_DATA_DIR=./data/seed

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo Mode (forces use of cached/mock responses for guaranteed deterministic demo)
DEMO_MODE=false
